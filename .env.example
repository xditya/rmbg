# Nothing here is required. The app runs with no environment at all.

# Absolute origin used for canonical and Open Graph URLs. On Vercel it is derived from
# VERCEL_PROJECT_PRODUCTION_URL automatically; elsewhere it falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://rmbg.example.com

# --- the HTTP API (/api/v1) ---

# Lock the API to one key. When set, requests need `Authorization: Bearer <key>`; the page is not affected.
# API_KEY=

# Requests per minute per IP. Default 10. A single number; the window is always a minute.
# RATE_LIMIT_PER_MIN=10

# Share the rate limit across instances with Upstash Redis (sliding window). Without it each
# process keeps its own fixed window in memory. The Vercel Marketplace names (KV_REST_API_URL /
# KV_REST_API_TOKEN) also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Self-hosting behind a reverse proxy: number of trusted proxies adding X-Forwarded-For.
# Vercel needs nothing (0 there). Default 1 elsewhere.
# TRUSTED_PROXY_HOPS=1

# Where the API fetches the ISNet weights (a directory with resources.json and the model chunks).
# Defaults to imgly's CDN, the same files the browser uses, and the file must match the sha256
# pinned in src/lib/config.ts. Cached under $TMPDIR/rmbg/ after that.
# RMBG_MODEL_URL=https://staticimgly.com/@imgly/background-removal-data/1.7.0/dist/

# With RMBG_MODEL_URL set, the sha256 the assembled model must hash to. Unset, a mirror is
# only checked chunk by chunk against its own resources.json.
# RMBG_MODEL_SHA256=d1ca3535c21b53d08fa3b640e5949389f82e764f6376a0502d44982c35cae482

# Local testing only. Never set this in production.
# DISABLE_RATE_LIMIT=1
